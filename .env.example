# ============================================================
# Canvas Engagement Pulse — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Only Canvas LMS credentials are required. This folder pulls
# analytics directly from the Canvas Analytics API — it does not
# connect to ValleyPROD/Oracle (that's only needed for the separate
# SIS enrollment-provisioning pipeline).
# ============================================================

# ------ Canvas LMS ------
# Production URL (no trailing slash)
CANVAS_URL=https://mvsu.instructure.com
# Admin API token (Settings -> Approved Integrations -> New Access Token)
CANVAS_TOKEN=your_canvas_api_token_here
# Root account ID (almost always 1)
CANVAS_ACCOUNT_ID=1

# ------ Pipeline behaviour ------
# Directory where generated JSON/CSV files are written
OUTPUT_DIR=./output
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
